@model Product
@{
    ViewData["Title"] = "Видалення товару";
}

<h1 class="h3 mb-3 text-danger">Видалити товар?</h1>

<div class="card mb-3" style="max-width:520px">
    <div class="row g-0">
        <div class="col-5 p-2"><partial name="_ProductImage" model="Model.Image" /></div>
        <div class="col-7">
            <div class="card-body">
                <h2 class="h5">@Model.Name</h2>
                <p class="mb-1">@Model.Category?.Name</p>
                <p class="fw-bold mb-0">@Model.Price.ToString("N0") ₴</p>
            </div>
        </div>
    </div>
</div>

<p>Товар і його фото буде видалено назавжди.</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Так, видалити</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
</form>
