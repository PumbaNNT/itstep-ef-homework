@model CartViewModel
@{
    ViewData["Title"] = "Кошик";
}

<h1 class="h3 mb-4">Кошик</h1>

@if (!Model.Lines.Any())
{
    <div class="text-center py-5 bg-light rounded">
        <p class="lead mb-3">Кошик порожній</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">До каталогу</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            @foreach (var line in Model.Lines)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="row g-0 align-items-center">
                        <div class="col-3 col-md-2 p-2">
                            <partial name="_ProductImage" model="line.Product.Image" />
                        </div>
                        <div class="col-9 col-md-4 p-2">
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@line.Product.Id" class="fw-semibold text-reset">@line.Product.Name</a>
                            <div class="small text-muted">@line.Product.Category?.Name</div>
                            <div class="small">@line.Product.Price.ToString("N0") ₴ / шт.</div>
                        </div>
                        <div class="col-7 col-md-3 p-2">
                            <div class="d-flex align-items-center gap-2">
                                <form asp-action="Decrease" method="post">
                                    <input type="hidden" name="productId" value="@line.Product.Id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Зменшити кількість">−</button>
                                </form>
                                <span class="fw-bold px-2" data-qty="@line.Product.Id">@line.Quantity</span>
                                <form asp-action="Increase" method="post">
                                    <input type="hidden" name="productId" value="@line.Product.Id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Збільшити кількість">+</button>
                                </form>
                            </div>
                        </div>
                        <div class="col-5 col-md-3 p-2 text-end">
                            <div class="fw-bold">@line.LineTotal.ToString("N0") ₴</div>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@line.Product.Id" />
                                <button type="submit" class="btn btn-link btn-sm text-danger p-0">Видалити</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Разом</h2>
                    <div class="d-flex justify-content-between">
                        <span>Товарів:</span><span>@Model.TotalQuantity шт.</span>
                    </div>
                    <div class="d-flex justify-content-between fs-4 fw-bold my-2">
                        <span>Сума:</span><span id="cart-total">@Model.Total.ToString("N0") ₴</span>
                    </div>
                    <form asp-action="Checkout" method="post">
                        <button type="submit" class="btn btn-success w-100 btn-lg">Оформити замовлення</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
