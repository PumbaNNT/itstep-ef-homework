@model Product

<div class="col">
    <div class="card h-100 shadow-sm product-card">
        <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" class="card-img-top">
            <partial name="_ProductImage" model="Model.Image" />
        </a>
        <div class="card-body d-flex flex-column">
            <h3 class="card-title h6">
                <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" class="text-reset text-decoration-none">@Model.Name</a>
            </h3>
            <div class="small mb-1">
                <span class="text-warning">★</span> @Model.Rating.ToString("0.0")
                <span class="text-muted ms-1">@Model.Category?.Name</span>
            </div>
            <p class="card-text small text-muted flex-grow-1">@Model.Description</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-success">@Model.Price.ToString("N0") ₴</span>
                <span class="badge @(Model.Amount > 10 ? "bg-success" : "bg-warning text-dark")">
                    @(Model.Amount > 0 ? $"В наявності: {Model.Amount}" : "Немає")
                </span>
            </div>
        </div>
    </div>
</div>
