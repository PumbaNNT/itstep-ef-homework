@model ProductFormViewModel
@{
    ViewData["Title"] = "Редагування товару";
}

<h1 class="h3 mb-3">Редагування: @Model.Name</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <partial name="_ProductForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Зберегти зміни</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Скасувати</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
